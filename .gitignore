# ============================================================
# AhBiCamViewer .gitignore (Strict Core Repository Filter)
# Developer: AhBiYout
# GitHub Account: AhBiYout-all
# Repository: https://github.com/AhBiYout-all/AhBiCamViewer
# Official Blog: https://ahbiyoutvibe.blogspot.com/
# ============================================================

# ------------------------------------------------------------
# 1. Build Artifacts, Compiled Binaries & Staging Directories
# ------------------------------------------------------------
dist/
build/
bin/
out/
output/
release/
release_body.md
*.exe
*.dll
*.pdb
*.obj
*.lib
*.exp
*.ilk
*.msi
*.zip
*.tar.gz
*.7z
*.rar
*.exe.log
*.iscc.log

# ------------------------------------------------------------
# 2. Local Git Release & Push Automation Scripts (Strictly Local)
#    (Must NEVER be pushed or uploaded to GitHub)
# ------------------------------------------------------------
*push*.bat
*push*.ps1
*push*.cjs
*push*.js
*push*.sh
*release*.bat
*release*.ps1
*release*.cjs
*release*.js
*release*.sh
git_push*
git-push*
git_release*
git-release*
tools/*push*
tools/*release*

# Explicit whitelist: NEVER ignore GitHub Actions CI/CD workflows
!/.github/
!/.github/workflows/
!/.github/workflows/**

# ------------------------------------------------------------
# 3. Private Keys, Secrets, Credentials & Personal Environment
# ------------------------------------------------------------
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
auth/
id_rsa*
*.secret
*.token

# ------------------------------------------------------------
# 4. Logs, Caches, Scratches & Temporary Development Scripts
# ------------------------------------------------------------
*.log
*.tmp
*.bak
*.swp
*.swo
*~
*.patch
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
.cache/
tmp/
temp/
scratch/
tools/inspect_*
tools/test_*
tools/apply_*
tools/list_*
tools/temp_*
tools/update_*
update_*.cjs

# ------------------------------------------------------------
# 5. Operating System Artifacts
# ------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# ------------------------------------------------------------
# 6. IDE, Editors & Development Workspaces
# ------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
