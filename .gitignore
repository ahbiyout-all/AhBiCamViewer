# ------------------------------------------------------------
# 1. Build Artifacts, Compiled Binaries & Release Outputs
# ------------------------------------------------------------
dist/
build/
bin/
out/
output/
release/
release_body.md
*.exe
*.dll
*.pdb
*.obj
*.lib
*.exp
*.ilk
*.msi
*.zip
*.tar.gz
*.7z
*.rar
*.exe.log

# ------------------------------------------------------------
# 2. Local Git Release & Push Automation Scripts (Strictly Local)
# ------------------------------------------------------------
push_to_github.bat
push_github.bat
push.bat
git_push.bat
git-push.bat
git-release.bat
tools/push*
tools/*push*

# ------------------------------------------------------------
# 3. Private Keys, Secrets, Credentials & Personal Environment
# ------------------------------------------------------------
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
auth/
id_rsa*
*.secret
*.token

# ------------------------------------------------------------
# 4. Logs, Caches, Scratches & Temporary Files
# ------------------------------------------------------------
*.log
*.tmp
*.bak
*.swp
*.swo
*~
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.cache/
tmp/
temp/
scratch/
tools/inspect_*
tools/test_*
tools/apply_*
tools/list_*
update_*.cjs

# ------------------------------------------------------------
# 5. Operating System Artifacts
# ------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# ------------------------------------------------------------
# 6. IDE, Editors & Development Workspaces
# ------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
